{
  "name": "ada-agent-wallet",
  "version": "0.1.0",
  "description": "Policy-gated Cardano wallet for AI agents: spend caps, payee allowlist, human approval, audit log. Plugs into the official @x402/cardano client.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test --import tsx test/*.test.ts",
    "signerd": "tsx src/signerd.ts",
    "mcp": "tsx src/mcp.ts",
    "walletctl": "tsx src/walletctl.ts",
    "dev:facilitator": "tsx dev/facilitator.ts",
    "dev:resource": "tsx dev/resource.ts",
    "roundtrip": "tsx dev/roundtrip.ts",
    "balance": "tsx dev/balance.ts",
    "concurrency": "tsx dev/concurrency.ts",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "pretest": "node scripts/verify-vendor.mjs",
    "integrity": "tsx dev/integrity.ts",
    "keystore": "tsx scripts/keystore.ts",
    "approvals": "tsx dev/approvals.ts",
    "queue": "tsx dev/queue.ts",
    "posix": "tsx dev/posix.ts",
    "delivery": "tsx dev/delivery.ts",
    "context": "tsx dev/context.ts",
    "assets": "tsx dev/assets.ts",
    "identity": "tsx dev/identity.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/cardano": "file:vendor/x402-cardano-2.25.0.tgz",
    "@x402/core": "file:vendor/x402-core-2.25.0.tgz",
    "@x402/fetch": "^2.25.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
