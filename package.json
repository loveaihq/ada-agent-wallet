{
  "name": "ada-agent-wallet",
  "version": "0.1.0",
  "description": "Out-of-process spend control for AI agents paying with x402: per-tx and rolling caps, payee allowlist, human approval, and a hash-chained audit log — enforced in a separate daemon that holds the key, not in the agent. Settles on Cardano.",
  "type": "module",
  "bin": {
    "ada-agent-wallet": "dist/mcp.js",
    "ada-signerd": "dist/signerd.js",
    "ada-wallet-mcp": "dist/mcp.js",
    "ada-walletctl": "dist/walletctl.js",
    "ada-keystore": "dist/keystoreCli.js"
  },
  "files": [
    "dist",
    "policy.example.json",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "Vincent <loveaihqhq@gmail.com>",
  "keywords": [
    "cardano",
    "x402",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-payments",
    "wallet",
    "spend-policy",
    "x402-cardano"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loveaihq/ada-agent-wallet.git"
  },
  "homepage": "https://github.com/loveaihq/ada-agent-wallet#readme",
  "bugs": "https://github.com/loveaihq/ada-agent-wallet/issues",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test --import tsx test/*.test.ts",
    "signerd": "tsx src/signerd.ts",
    "mcp": "tsx src/mcp.ts",
    "walletctl": "tsx src/walletctl.ts",
    "dev:facilitator": "tsx dev/facilitator.ts",
    "dev:resource": "tsx dev/resource.ts",
    "dev:mcpresource": "tsx dev/mcpresource.ts",
    "roundtrip": "tsx dev/roundtrip.ts",
    "balance": "tsx dev/balance.ts",
    "concurrency": "tsx dev/concurrency.ts",
    "integrity": "tsx dev/integrity.ts",
    "keystore": "tsx src/keystoreCli.ts",
    "approvals": "tsx dev/approvals.ts",
    "queue": "tsx dev/queue.ts",
    "posix": "tsx dev/posix.ts",
    "delivery": "tsx dev/delivery.ts",
    "context": "tsx dev/context.ts",
    "assets": "tsx dev/assets.ts",
    "identity": "tsx dev/identity.ts",
    "mcptools": "tsx dev/mcptools.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/cardano": "^2.26.0",
    "@x402/core": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "@x402/mcp": "^2.26.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
